# 卷云 Cirrus 许可证服务器配置。复制为 .env 后修改：cp .env.example .env
# 每行一个 KEY=VALUE；值不要加引号，除非包含 $ 等特殊字符（此时用单引号）。
# 改完后执行 docker compose up -d 让配置生效。

# ---------- 基本 ----------
# 对外网址（无结尾斜杠）。用于支付宝回调地址、邮件中的链接和后台的同源检查。
PUBLIC_URL=https://cirrus.routeforge.zone
# 是否信任反向代理（1Panel 的 OpenResty）传来的 X-Real-IP / X-Forwarded-For。
# 只在直接连接来自本机或内网地址时才采信。默认 true。
TRUST_PROXY=true
# 网站前面还有 CDN（例如腾讯云 EdgeOne）时，填 CDN 放客户端真实 IP 的请求头，
# EdgeOne 填 EO-Connecting-IP。不填则用反向代理的 X-Real-IP（此时会是 CDN 节点的 IP）。
CLIENT_IP_HEADER=
# 容器内监听地址和数据目录。用 Docker 部署时不要修改（端口映射和数据卷依赖它们）。
# LISTEN=:8080
# DATA_DIR=/data

# ---------- 管理后台 ----------
# /admin 的密码（用户名固定为 admin）。留空则关闭后台。
# 建议用 openssl rand -base64 24 | tr -d '/+=' 生成。
ADMIN_PASSWORD=

# ---------- 网站信息 ----------
SITE_NAME=卷云 Cirrus
# 运营者名称（个体户名称），显示在页脚、隐私政策和用户协议中。
OPERATOR_NAME=
# 客服邮箱，显示在网站上，也是隐私政策中的联系方式。
CONTACT_EMAIL=
# ICP 备案号，显示在每个页面的页脚并链接到 https://beian.miit.gov.cn/
ICP_NUMBER=
# 隐私政策和用户协议的生效日期。
POLICY_EFFECTIVE_DATE=2026-10-06
# 可选：App Store 地址（iPhone、iPad 和 Mac），显示在首页和下载页。
APP_STORE_URL=

# ---------- 下载 ----------
# 推荐：安装包直接放在本站，用 scripts/publish_download.sh 发布（见 DEPLOY.md
# “发布下载文件”）。它把文件放进 data/downloads/ 并写 data/downloads/manifest.json，
# 不需要改这里。下面的链接用于放在别处的安装包；某个平台在 manifest.json 里有
# 文件时，以 manifest.json 为准。不配置的平台不显示。
# DOWNLOAD_URL_WINDOWS=https://example.com/Cirrus-1.2.0-windows-setup.exe
# DOWNLOAD_URL_MACOS=
# DOWNLOAD_URL_LINUX=
# DOWNLOAD_URL_ANDROID=
# 版本号（全部平台，或用 DOWNLOAD_VERSION_<平台> 单独指定）和 SHA-256（64 位十六进制）：
# DOWNLOAD_VERSION=1.2.0
# DOWNLOAD_SHA256_WINDOWS=
# 可选：“全部下载”链接（例如 GitHub Releases 页面）。
DOWNLOAD_URL=

# ---------- 产品、价格与设备数 ----------
# 在售产品：windows、macos（官网直售的 Developer ID 版）、linux、android，逗号分隔。
# 下架的产品不再出现在网站上，但已售出的许可证照常激活。
PRODUCTS=windows,macos,linux,android
# 价格通常在后台“价格”页（/admin/prices）修改，保存在数据库里，立即生效，
# 并且优先于这里的设置。下面是后台没有设置过的产品使用的默认值。
# 默认人民币价格（全部产品），可写 198 或 198.00。
PRICE_CNY=198
# 美元参考价，仅用于显示。
PRICE_USD=39.99
# 按产品覆盖（可选）：
# PRICE_CNY_WINDOWS=198
# PRICE_CNY_MACOS=198
# PRICE_CNY_LINUX=198
# PRICE_CNY_ANDROID=198
# PRICE_USD_WINDOWS=39.99
# PRICE_USD_MACOS=39.99
# PRICE_USD_LINUX=39.99
# PRICE_USD_ANDROID=39.99
# 每个许可证可同时激活的设备数（默认 Windows 1、macOS 1、Linux 1、Android 3）。
# 只影响之后签发的许可证。
# MAX_DEVICES_WINDOWS=1
# MAX_DEVICES_MACOS=1
# MAX_DEVICES_LINUX=1
# MAX_DEVICES_ANDROID=3

# ---------- 收款 ----------
# 购买页提供的付款方式：alipay、wechat，逗号分隔。
# 默认使用静态收款码：把图片放到 data/pay/alipay.png 和 data/pay/wechat.png，
# 买家付款时备注订单号，你在 /admin 确认收款后自动签发许可证。缺图片的方式显示为“暂不可用”。
PAY_METHODS=alipay,wechat

# ---------- 支付宝开放平台（可选，自动确认收款） ----------
# 三项都填写后启用；此时“支付宝”不再使用静态收款码。
# 只支持“公钥模式”（不是证书模式），签名方式 RSA2。
# ALIPAY_APP_ID：开放平台应用的 APPID。
ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY：应用私钥（用支付宝密钥工具生成的“应用私钥”）。
#   可直接粘贴密钥工具导出的一整行 base64（不带 -----BEGIN 头），
#   也可以是 PEM（PKCS#8 或 PKCS#1），多行时用字面量 \n 连接成一行。
ALIPAY_PRIVATE_KEY=
# ALIPAY_PUBLIC_KEY：支付宝公钥（上传应用公钥后，在开放平台“接口加签方式”里查看的“支付宝公钥”）。
#   注意：不是“应用公钥”！格式同上，一整行 base64 或 PEM。
ALIPAY_PUBLIC_KEY=
# 收款产品：
#   page      = 电脑网站支付（alipay.trade.page.pay，手机上自动改用手机网站支付 wap.pay）。网站销售的正规产品。
#   precreate = 当面付（alipay.trade.precreate，页面显示二维码），通常更容易开通。默认。
ALIPAY_MODE=precreate
# 网关。沙箱测试时改为 https://openapi-sandbox.dl.alipaydev.com/gateway.do
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do
# 支付宝异步通知地址固定为 PUBLIC_URL + /pay/alipay/notify，无需配置。

# ---------- 微信支付 APIv3 Native 支付（可选，自动确认收款） ----------
# 下面 7 项都填写后启用；此时“微信”使用 Native 动态二维码，接口失败时退回 data/pay/wechat.png。
# 只支持“微信支付公钥”验签（不是“平台证书”）。详见 DEPLOY.md“开通微信支付 API”。
# WECHAT_MCHID：商户号。
WECHAT_MCHID=
# WECHAT_APPID：与商户号绑定的 AppID（服务号或小程序）。
WECHAT_APPID=
# WECHAT_API_V3_KEY：APIv3 密钥，32 个字符。
WECHAT_API_V3_KEY=
# WECHAT_CERT_SERIAL：商户 API 证书序列号（openssl x509 -in apiclient_cert.pem -noout -serial 中 serial= 后的部分）。
WECHAT_CERT_SERIAL=
# WECHAT_PRIVATE_KEY：商户 API 私钥 apiclient_key.pem 的内容。
#   可以是去掉 -----BEGIN/END 行后的一整行 base64，也可以是 PEM（多行时用字面量 \n 连接成一行）。
WECHAT_PRIVATE_KEY=
# WECHAT_PUBLIC_KEY：微信支付公钥 pub_key.pem 的内容，格式同上。
WECHAT_PUBLIC_KEY=
# WECHAT_PUBLIC_KEY_ID：微信支付公钥 ID，形如 PUB_KEY_ID_0114…
WECHAT_PUBLIC_KEY_ID=
# 网关，一般不用改。
# WECHAT_GATEWAY=https://api.mch.weixin.qq.com
# 微信支付通知地址固定为 PUBLIC_URL + /pay/wechat/notify，每次下单时自动传给微信，无需配置。

# ---------- App 登录：Cloudflare OAuth（GET /api/v1/oauth/config） ----------
# App 点“使用 Cloudflare 登录”前读取这里的 client_id 和权限范围（scopes），改权限无需发布新版 App。
# OAuth 客户端 ID，默认即 Cirrus 的客户端。
# OAUTH_CLIENT_ID=9c147a5155baf903357222bd4d31ad50
# 权限范围，空格或逗号分隔。未配置自动同步、或同步还没成功时使用；两者都没有时接口返回 404。
# offline_access 和 openid 会被去掉（App 自己会加 offline_access）。
OAUTH_SCOPES=
# 可选权限范围（用户可以不授权的）。
OAUTH_OPTIONAL_SCOPES=
# 可选：从 Cloudflare API 自动同步该 OAuth 客户端的权限范围（每小时刷新，失败时继续用上次的结果）。
# 填 CF_ACCOUNT_ID，再填 CF_API_TOKEN（推荐），或者 CF_API_EMAIL + CF_API_KEY（Global API Key）。
CF_ACCOUNT_ID=
CF_API_TOKEN=
CF_API_EMAIL=
CF_API_KEY=

# ---------- 邮件（可选，发送许可证） ----------
# 填写 SMTP_HOST 后启用：付款后自动发送许可证，并在“许可证”页面提供“找回许可证”。
# 腾讯云封禁 25 端口，请用 465（SSL，默认）或 587（STARTTLS）。
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# 发件人，例如 卷云 Cirrus <noreply@routeforge.zone>；留空时使用 SMTP_USER。
SMTP_FROM=

# ---------- 构建（docker compose 读取，不传给程序） ----------
# 可选：apk 镜像，例如 mirrors.tencent.com（腾讯云服务器上更快）。
# ALPINE_MIRROR=mirrors.tencent.com
# 仅源码构建时使用：Go 模块代理，国内可用 https://goproxy.cn,direct
# GOPROXY=https://goproxy.cn,direct
