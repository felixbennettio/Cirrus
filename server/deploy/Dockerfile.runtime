# Runtime-only image for the deployment bundle: no compiler, it just copies
# the prebuilt static binary for this machine's architecture.
#
# The "pick" stage chooses bin/cirrus-license-amd64 or -arm64 from `uname -m`
# of the build container, which matches the server (x86_64 → amd64,
# aarch64 → arm64), so only one binary ends up in the final image.
FROM alpine:3.20 AS pick
COPY bin/ /bin-src/
RUN case "$(uname -m)" in \
      x86_64) arch=amd64 ;; \
      aarch64|arm64) arch=arm64 ;; \
      *) echo "unsupported architecture: $(uname -m)" >&2; exit 1 ;; \
    esac \
 && cp "/bin-src/cirrus-license-$arch" /cirrus-license \
 && chmod 0755 /cirrus-license

FROM alpine:3.20
# Optional apk mirror host, e.g. mirrors.tencent.com or mirrors.aliyun.com.
ARG ALPINE_MIRROR=
RUN if [ -n "$ALPINE_MIRROR" ]; then sed -i "s#dl-cdn.alpinelinux.org#${ALPINE_MIRROR}#g" /etc/apk/repositories; fi \
 && apk add --no-cache ca-certificates tzdata \
 && addgroup -S -g 10001 cirrus \
 && adduser -S -D -H -u 10001 -G cirrus cirrus \
 && mkdir -p /data && chown cirrus:cirrus /data
ENV TZ=Asia/Shanghai DATA_DIR=/data LISTEN=:8080 GOMEMLIMIT=96MiB
COPY --from=pick /cirrus-license /usr/local/bin/cirrus-license
USER cirrus
VOLUME /data
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -q -O /dev/null http://127.0.0.1:8080/healthz || exit 1
ENTRYPOINT ["/usr/local/bin/cirrus-license"]
